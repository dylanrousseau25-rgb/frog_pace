APP_URL=https://frogpace.kumazel.fr

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CPANELUSER_frogpace
DB_USER=CPANELUSER_frogpace
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=6

# 32 random bytes encoded as 64 hexadecimal characters.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Optional until TrainingPeaks grants partner API credentials.
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
